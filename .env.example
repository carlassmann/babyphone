# bun run setup generates private VAPID keys in .env.local for local testing.
# Keep .env.local and .data private.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional TURN fallback for restrictive / different networks.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Required for a future Vercel deployment. Never use local disk there.
JAZZ_APP_ID=
JAZZ_SERVER_URL=
JAZZ_BACKEND_SECRET=
APP_ORIGIN=
