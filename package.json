{
  "name": "babyphone",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "miniflare": "^5.20260831.0-alpha",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@tanstack/react-router": "^1.170.32",
    "lucide-react": "^1.38.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "web-push": "^3.6.7"
  },
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "dev": "work up",
    "build": "bun --bun vite build && bun scripts/build-sw.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "bun run build:worker && bun test tests/monitor.test.ts && node --experimental-strip-types --test tests/cloudflare.test.ts",
    "test:e2e": "bunx playwright test",
    "preview": "bun --bun vite preview",
    "setup:https": "bun scripts/https-setup.ts",
    "format": "prettier --write src worker scripts tests e2e *.ts *.json *.jsonc work.config.js public/sw.js",
    "build:worker": "wrangler deploy --dry-run --outdir .worker-build"
  },
  "packageManager": "bun@1.4.0"
}
